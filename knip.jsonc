{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "rules": {
    // Deprecated/renamed aliases (e.g. `txidFromData` -> `txidFromBytes`) are kept on
    // purpose, so duplicates are reported without failing the run.
    "duplicates": "warn"
  },
  // husky is installed into .github/.husky (see the root `prepare` script), which the
  // husky and commitlint plugins do not scan by default.
  "husky": { "config": [".github/.husky/*"] },
  "commitlint": { "config": [".github/.husky/commitlint.json"] },
  // `@knipignore` marks an export that is deliberately kept without a caller, e.g. one
  // half of a documented API whose other half is in use.
  "tags": ["-knipignore"],
  "workspaces": {
    "packages/bitcoin-staking": {
      // The regtest/privatenet harness keeps helper modules fully exported even where a
      // helper is currently only used inside its own module.
      "ignoreExportsUsedInFile": true
    }
  }
}
